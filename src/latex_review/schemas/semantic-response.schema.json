{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latex-review.local/schemas/semantic-response.schema.json",
  "title": "Semantic response 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task": {
      "enum": [
        "concept_definition",
        "name_mapping",
        "cross_section_comparison"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "concept",
              "definition",
              "use_role",
              "same_concept",
              "different_concept",
              "code_mapping",
              "potential_contradiction",
              "missing_qualification",
              "evidence_insufficient"
            ]
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "unit_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "unit_id",
                "quote"
              ]
            },
            "minItems": 1,
            "maxItems": 16
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "missing_context": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 0,
            "maxItems": 16
          },
          "object_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "required": [
          "kind",
          "hypothesis",
          "evidence",
          "rationale",
          "missing_context"
        ]
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "task",
    "candidates"
  ]
}
