{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinghonh/LaTeX-Review/blob/main/src/latex_review/schemas/diff.schema.json",
  "title": "LaTeX Review diff.json 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry", "old", "new", "nodes_old", "nodes_new", "changes", "diagnostics", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entry": {"type": "string", "minLength": 1},
    "old": {"$ref": "#/$defs/comparison_source"},
    "new": {"$ref": "#/$defs/comparison_source"},
    "nodes_old": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "nodes_new": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "comparison_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {"kind": {"enum": ["git", "worktree", "directory", "file"]}, "identifier": {"type": "string", "minLength": 1}}
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "start_line", "end_line", "start_column", "end_column", "confidence", "uncertainty_reason"],
      "properties": {
        "file": {"type": ["string", "null"], "minLength": 1, "pattern": "^(?!/|\\\\|[A-Za-z]:)"},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "start_column": {"type": ["integer", "null"], "minimum": 1},
        "end_column": {"type": ["integer", "null"], "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"file": {"type": "null"}}}, "then": {"properties": {"uncertainty_reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"start_line": {"type": "null"}}}, "then": {"properties": {"uncertainty_reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"end_line": {"type": "null"}}}, "then": {"properties": {"uncertainty_reason": {"type": "string", "minLength": 1}}}}
      ]
    },
    "nullable_location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "raw_latex", "parent_id", "child_ids", "section_path", "source", "normalized_latex", "plain_text"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "raw_latex": {"type": "string"}, "parent_id": {"type": ["string", "null"]},
        "child_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "section_path": {"type": "array", "items": {"type": "string"}},
        "source": {"$ref": "#/$defs/location"},
        "normalized_latex": {"type": ["string", "null"]}, "plain_text": {"type": ["string", "null"]}
      }
    },
    "detail": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "kind", "old_text", "new_text", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "category": {"$ref": "#/$defs/category"},
        "kind": {"$ref": "#/$defs/kind"}, "old_text": {"type": ["string", "null"]},
        "new_text": {"type": ["string", "null"]}, "summary": {"type": "string"}
      }
    },
    "category": {"enum": ["text", "equation", "figure", "table", "citation", "comment"]},
    "kind": {"enum": ["added", "removed", "modified", "moved"]},
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "node_type", "old_node_id", "new_node_id", "source_old", "source_new", "matching_confidence", "categories", "details", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/kind"},
        "node_type": {"type": "string", "minLength": 1},
        "old_node_id": {"type": ["string", "null"]}, "new_node_id": {"type": ["string", "null"]},
        "source_old": {"$ref": "#/$defs/nullable_location"}, "source_new": {"$ref": "#/$defs/nullable_location"},
        "matching_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}, "uniqueItems": true},
        "details": {"type": "array", "items": {"$ref": "#/$defs/detail"}},
        "summary": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "added"}}}, "then": {"properties": {"old_node_id": {"type": "null"}, "source_old": {"type": "null"}, "new_node_id": {"type": "string"}, "source_new": {"$ref": "#/$defs/location"}}}},
        {"if": {"properties": {"kind": {"const": "removed"}}}, "then": {"properties": {"new_node_id": {"type": "null"}, "source_new": {"type": "null"}, "old_node_id": {"type": "string"}, "source_old": {"$ref": "#/$defs/location"}}}},
        {"if": {"properties": {"kind": {"enum": ["modified", "moved"]}}}, "then": {"properties": {"old_node_id": {"type": "string"}, "new_node_id": {"type": "string"}, "source_old": {"$ref": "#/$defs/location"}, "source_new": {"$ref": "#/$defs/location"}}}}
      ]
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "message", "source_old", "source_new"],
      "properties": {
        "code": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string"}, "source_old": {"$ref": "#/$defs/nullable_location"}, "source_new": {"$ref": "#/$defs/nullable_location"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["changes", "category_hits", "added_words", "removed_words"],
      "properties": {
        "changes": {"type": "integer", "minimum": 0},
        "category_hits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "propertyNames": {"$ref": "#/$defs/category"}},
        "added_words": {"type": "integer", "minimum": 0}, "removed_words": {"type": "integer", "minimum": 0}
      }
    }
  }
}
