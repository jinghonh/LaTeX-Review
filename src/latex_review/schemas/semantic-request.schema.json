{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latex-review.local/schemas/semantic-request.schema.json",
  "title": "Semantic request 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "prompt_version": {
      "enum": [
        "semantic-1",
        "semantic-2"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task": {
      "enum": [
        "concept_definition",
        "name_mapping",
        "cross_section_comparison"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "paper_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
        },
        "content_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "knowledge_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "knowledge_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rules_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parser_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "input_id",
        "paper_id",
        "entry",
        "content_id",
        "knowledge_hash",
        "knowledge_revision",
        "rules_hash",
        "configuration_hash",
        "parser_version",
        "engine_version"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "response_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_candidate_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "concept",
              "definition",
              "use_role",
              "same_concept",
              "different_concept",
              "code_mapping",
              "potential_contradiction",
              "missing_qualification",
              "evidence_insufficient"
            ]
          },
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true
        },
        "allowed_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "evidence_coordinate_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "evidence_range_example": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit_text": {"type": "string", "const": "Alpha beta."},
            "quote": {"type": "string", "const": "Alpha"},
            "start": {"type": "integer", "const": 0},
            "end": {"type": "integer", "const": 5}
          },
          "required": ["unit_text", "quote", "start", "end"]
        }
      },
      "required": [
        "allowed_candidate_kinds",
        "allowed_object_ids",
        "evidence_coordinate_system",
        "evidence_range_example"
      ]
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "enum": [
                  "concepts",
                  "symbol_bindings",
                  "relations"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "type",
              "label"
            ]
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "objects"
      ]
    },
    "evidence_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "section_path": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 32
          },
          "reading_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "representation": {
            "enum": [
              "raw_latex"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
                },
                "content_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Absolute Unicode code-point offset in this source file; candidate evidence ranges use evidence_units[].text coordinates instead."
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Absolute Unicode code-point offset in this source file; candidate evidence ranges use evidence_units[].text coordinates instead."
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "include_instance": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "start_column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reliability": {
                  "enum": [
                    "exact",
                    "unknown"
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  ]
                }
              },
              "required": [
                "entry",
                "content_id",
                "file",
                "file_sha256",
                "start",
                "end",
                "quote",
                "include_instance",
                "start_line",
                "start_column",
                "end_line",
                "end_column",
                "reliability",
                "reason"
              ]
            },
            "minItems": 1,
            "maxItems": 512
          }
        },
        "required": [
          "id",
          "node_id",
          "kind",
          "section_path",
          "reading_order",
          "representation",
          "text",
          "sources"
        ]
      },
      "minItems": 1,
      "maxItems": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"prompt_version": {"const": "semantic-2"}},
        "required": ["prompt_version"]
      },
      "then": {"required": ["response_contract"]}
    }
  ],
  "required": [
    "schema_version",
    "prompt_version",
    "request_id",
    "task",
    "versions",
    "instructions",
    "knowledge",
    "evidence_units"
  ]
}
